          "name": "Listen for Changes",
          "request": {
            "name": "Listen for Changes",
            "description": {
              "content": "Subscribe to real-time content changes via Server-Sent Events (SSE). The connection stays open and streams events when GROQ-matching documents are created, updated, or deleted.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "listen",
                ":dataset"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) GROQ query defining which documents to listen to"
                },
                {
                  "disabled": false,
                  "key": "includeResult",
                  "value": "<boolean>",
                  "description": "Include full document in change events"
                },
                {
                  "disabled": false,
                  "key": "visibility",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dataset",
                  "description": "(Required) "
                },
                {
                  "description": "Your Sanity project ID",
                  "type": "any",
                  "value": "{{projectId}}",
                  "key": "projectId"
                },
                {
                  "description": "API version date (YYYY-MM-DD)",
                  "type": "any",
                  "value": "{{apiVersion}}",
                  "key": "apiVersion"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
